# ---- Dependencies ----
node_modules/
.pnpm-store/
.pnp.*
.yarn/

# ---- Build output ----
.next/
out/
dist/
build/
*.tsbuildinfo
# Generated by Next.js on every dev/build run; not source.
next-env.d.ts

# ---- Tauri / Rust ----
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
**/*.rs.bk
# Cargo.lock and pnpm-lock.yaml stay tracked: this is an application, builds must be reproducible.

# ---- Tests and coverage ----
coverage/
.nyc_output/
playwright-report/
test-results/
.vitest-cache/

# ---- Environment and secrets ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ---- Local app data (privacy: never commit real planner data) ----
# Seed, screenshot and dev scripts must point SELF_PLANNER_DATA_DIR here.
.tmp/
tmp/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.db
backups/

# ---- Logs and caches ----
*.log
npm-debug.log*
pnpm-debug.log*
.eslintcache
.cache/
.turbo/

# ---- Release artifacts ----
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---- Editors and tools ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---- Agent tooling (local only) ----
.claude/settings.local.json
.claude/worktrees/
